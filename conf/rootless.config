// poly-suite overrides layered onto pgscatalog/pgsc_calc via `-c conf/rootless.config`.
// Rigor-preserving performance overrides only — none of these change scores/outputs.

docker.runOptions = ""

process {
    // --- Class-A perf: thread the PLINK2 scoring ---------------------------------
    // PLINK2_SCORE is used for BOTH the reference-panel scoring (--run_ancestry) and
    // the single-sample scoring. Upstream leaves it at label process_low (cpus=2); the
    // reference-panel task (HGDP+1kGP, ~4k genomes) is the long pole (~26 min at low
    // core count). `plink2 --score --threads N --seed 31` is deterministic in N — the
    // computed .sscore values are identical regardless of thread count — so raising
    // cpus parallelises the panel scoring WITHOUT changing any score. Bounded by the
    // pipeline's resourceLimits (params.max_cpus = 16), so 8 is always honoured.
    // Per-sample scoring is already fast; extra threads there are harmless.
    withName: '.*PLINK2_SCORE' {
        cpus = 8
    }

    // --- Class-A perf: bound DOWNLOAD_SCOREFILES failures ------------------------
    // The PGS-Catalog FTP fetch can fail transiently. Retry non-zero exits a bounded
    // number of times so a flaky fetch fails-loud instead of aborting the whole run on
    // the first blip. NOTE: this covers *erroring* fetches only. A silently *stalled*
    // connection (the ~66 min idle hang observed 2026-07-23) never exits, so the
    // Nextflow `time` directive is not enforced by the local executor and cannot kill
    // it — that hang is eliminated at the orchestration layer instead: bin/run.sh now
    // (a) prefers a persistent scorefile cache so this process is skipped entirely, and
    // (b) wraps the residual cache-miss harmonize run in a GNU `timeout` + retry.
    withName: '.*DOWNLOAD_SCOREFILES' {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

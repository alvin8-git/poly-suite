# poly-suite — track source only; everything below is data / build output.

# pipeline outputs and nextflow work dirs (tens of GB)
results/
work/
work_*/
.nextflow/
.nextflow.log*

# localized test data, caches, panels (large; fetched/derived, not source)
data/
cache/
*.vcf.gz
*.vcf.gz.tbi
*.pgen
*.pvar
*.psam
*.tar.zst
*.tar.zst.part

# logs, python cache, editor/agent scratch
logs/
scratch/
*.log
*.tmp
nohup.out
__pycache__/
*.pyc
.omc/

# large alignment / index binaries — never committed (volume-mounted at runtime)
*.bam
*.bai
*.cram
*.crai

# stray downloads / installers (e.g. FileZilla*.exe)
*.exe

# example outputs consolidated to docs/demo/ (single self-contained demo report);
# the old per-trait-set example cards are generated outputs, kept on disk but untracked.
examples/

# AI-harness config, not part of the pipeline
CLAUDE.md

# internal strategy doc (business wedge/competitive analysis) — not for public repo
docs/pgs-space-review.md
.gstack/

# manuscript draft for journal submission — local-only, not for public repo
manuscript/
